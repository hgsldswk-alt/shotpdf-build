    "error.freeLimit": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版は1ファイルにつき10枚までです。選択した画像は下書きに残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version allows 10 images per PDF. Your selection stays in the draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版每份最多 10 张，已选图片会保留在草稿中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版每份最多 10 張，已選圖片會保留在草稿中。"
          }
        }
      }
    },
    "error.missing": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得できない画像があります。再試行、差し替え、または除外してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images are unavailable. Retry, replace or remove them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有图片未能取回，请重试、替换或排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有圖片未能取回，請重試、替換或排除。"
          }
        }
      }
    },
