          "stringUnit": {
            "state": "translated",
            "value": "此預設代碼無效，請重新複製。"
          }
        }
      }
    },
    "error.storage": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に保存できませんでした。下書きを確認して再試行してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save on this device. Check the draft and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败，请检查草稿后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，請檢查草稿後再試。"
          }
        }
      }
    },
    "error.store": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。時間をおいて再試行してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store is unavailable. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法连接 App Store，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法連線至 App Store，請稍後再試。"
          }
        }
      }
    },
    "error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が大きすぎます。容量を抑えるか、長尺分割をオフにしてお試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image exceeds the processing budget. Try the compact option or turn off long-image splitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片超出处理范围。可试用轻量导出或关闭长图切分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片超出處理範圍。可試用精簡輸出或關閉長圖切分。"
          }
        }
      }
    },
    "error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めません。差し替えてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be read. Choose a replacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取图片，请替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取圖片，請替換。"
          }
        }
      }
    },
