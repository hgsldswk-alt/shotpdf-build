    "batch.longFree": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では長い画像を1枠に収めます。プレミアムなら分割できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long images fit in one slot. Premium can split them across pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版将长图完整放进一格。高级版可分割成多页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版將長圖完整放入一格。進階版可分割成多頁。"
          }
        }
      }
    },
