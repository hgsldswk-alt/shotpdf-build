          }
        }
      }
    },
    "error.noSpace": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の空き容量を確保して、再試行してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space on this device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请释放设备存储空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請釋放裝置儲存空間後再試。"
          }
        }
      }
    },
    "error.pdf": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを作成できませんでした。もう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF could not be created. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 生成失败，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 產生失敗，請重試。"
          }
        }
      }
    },
    "error.preset": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを読み込めません。コピーし直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset code is invalid. Copy it again."
