    "split.check": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のページに重なりがあります。分割位置を確認できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some pages overlap. You can check the breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分页面有重叠，可检查断点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分頁面有重疊，可檢查分頁位置。"
          }
        }
      }
    },
    "split.drag": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界を上下にドラッグできます。余白がない箇所では前後のページに一部を重ねます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the break up or down. Pages overlap where there is no clear gap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动断点。没有明显空隙时，相邻页面会重叠一小段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖曳分頁位置。沒有明顯空隙時，相鄰頁面會重疊一小段。"
          }
        }
      }
    },
